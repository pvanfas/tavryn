# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Configuration (Vercel AI SDK)
# Supported LLM_PROVIDER: gateway, openai, anthropic, mock
# Note: LLM_PROVIDER=gateway requires AI_GATEWAY_API_KEY
LLM_PROVIDER=gateway
LLM_MODEL=google/gemini-2.5-flash
REVIEWER_LLM_MODEL=google/gemini-2.5-pro
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Circle Developer-Controlled Wallets
# Obtain API key & Entity Secret from https://console.circle.com
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-32-byte-hex-entity-secret
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_SET_ID=

# Arc Network Testnet (USDC-native EVM)
# ARC_RPC_URL=https://rpc.testnet.arc-node... (optional server-only private RPC override)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x78e61ae7e8EeF34Add911FA3e41F3408a819c047
NEXT_PUBLIC_ARC_FAUCET_URL=https://faucet.circle.com
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Auth — set this to your deployment URL for email redirect links (e.g. https://tavryn.space or http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=https://tavryn.space

# Optional: Arc Testnet Contract Deployment
ARC_PRIVATE_KEY=your-deployer-private-key-hex

# Proactive Daily Agent & Notifications
CRON_SECRET=tavryn_cron_secret_2026
RENEWAL_WINDOW_DAYS=45
IDEMPOTENCY_WINDOW_DAYS=14
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
